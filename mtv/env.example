# /etc/mtv-player/env (see mtv_player.py for every option)
MTV_SERVER=http://atv-media.local:8080
# HDMI sound device: `mpv --audio-device=help` (Intel HDA: plughw:CARD=PCH,DEV=3 is usually the first HDMI port)
MTV_AUDIO_DEVICE=alsa/plughw:CARD=PCH,DEV=3
# screen mode index from `mpv --vo=gpu-next --gpu-context=drm --drm-mode=help` (one mode for everything)
MTV_DRM_MODE=0
# MTV_DRM_CONNECTOR=DP-1
# MTV_INTERPOLATION=1
# MTV_VOLUME=100   (first start only; later the web remote's volume bar, kept in the state directory)
# MTV_KEYS_DEVICE=/dev/input/by-id/*flirc*event-kbd
# Screensaver: black screen with the name moving around, after this many seconds paused / stopped / idle (default 300)
# MTV_SAVER_AFTER=300
# ... and the name jumps to a new spot this often (default 180)
# MTV_SAVER_MOVE=180
# Sound on the atv-audio headphones (chosen on the web remote: Settings > Audio): ms the headphones play earlier (default -100)
# MTV_LIP_SYNC=-100
# MTV_AUDIO_RTPRIO=70   (SCHED_FIFO for mpv's audio thread, 0 = off; the CT needs lxc.prlimit.rtprio: 95)
