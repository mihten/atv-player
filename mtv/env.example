# /etc/mtv-player/env (see mtv_player.py for every option)
MTV_SERVER=http://atv-media.local:8080
# HDMI sound device: `mpv --audio-device=help` (Intel HDA: plughw:CARD=PCH,DEV=3 is usually the first HDMI port)
MTV_AUDIO_DEVICE=alsa/plughw:CARD=PCH,DEV=3
# screen mode index from `mpv --vo=gpu-next --gpu-context=drm --drm-mode=help` (one mode for everything)
MTV_DRM_MODE=0
# MTV_DRM_CONNECTOR=DP-1
# MTV_INTERPOLATION=1
# MTV_VOLUME=100
