# atv-audio sink settings (copy to /etc/atv-audio/env, or pass to the container).
# Values here are examples: put the real server address in your own copy, not in the repository.

# Media server base URL (the sink reads the sound over HTTP from /media/<id>?audio=main).
ATV_AUDIO_SERVER=http://atv-media.local:8080

# Where the sound goes:
#   pipewire          the user's PipeWire (built-in Bluetooth through BlueZ, or a USB dongle)
#   pulse             PulseAudio, or pipewire-pulse
#   pulse:<server>    a PulseAudio server elsewhere, e.g. pulse:unix:/run/user/1000/pulse/native or pulse:tcp:<host>
#   alsa:<device>     an ALSA device directly, e.g. alsa:plughw:CARD=BTD700,DEV=0 (see 'aplay -L')
ATV_AUDIO_OUTPUT=pipewire

# Name shown on the Apple TV.
ATV_AUDIO_NAME=atv-audio

# mpv binary.
#ATV_AUDIO_MPV=mpv

# Seconds the output stays open after a pause / stop before it is released (headphones can then switch off).
#ATV_AUDIO_HOLD=300

# atv-audio's own queue in the web remote (plays without the Apple TV; the TV wins the output). 0 = off.
#ATV_AUDIO_BOX=1

# Headphone buttons (Play / Pause / Next / Previous, wear sensor) through BlueZ (needs python3-dbus) or a dongle. 0 = off.
#ATV_AUDIO_BUTTONS=1

# Sennheiser BTD 700: its hidraw node (interface 0 of USB 3542:3001). Headphone state, codec, connect / disconnect
# and buttons through the dongle; its own volume is set to 0 dB (amixer), the volume control is mpv's (headphones at max).
# Use with ATV_AUDIO_OUTPUT=alsa:plughw:CARD=B700,DEV=0.
#ATV_AUDIO_DONGLE=/dev/hidraw0

# Several atv-audio programs on one server: this one's id (default = ATV_AUDIO_NAME). One is active, the others wait
# in standby; Settings -> atv-audio -> Sound goes to switches.
#ATV_AUDIO_ID=atv-audio-bt

# output (default): PipeWire/Pulse set the output's own volume (Bluetooth absolute volume). mpv: the slider is
# mpv's volume and the output is pinned at 100 % (same as a dongle; use it when two programs share the headphones).
#ATV_AUDIO_VOLUME=mpv
