# atv-audio sink settings (copy to /etc/atv-audio/env, or pass to the container).
# Values here are examples: put the real server address in your own copy, not in the repository.

# Media server base URL (the sink reads the sound over HTTP from /media/<id>?audio=main).
ATV_AUDIO_SERVER=http://atv-media.local:8080

# Where the sound goes:
#   pipewire          the user's PipeWire (built-in Bluetooth through BlueZ, or a USB dongle)
#   pulse             PulseAudio, or pipewire-pulse
#   pulse:<server>    a PulseAudio server elsewhere, e.g. pulse:unix:/run/user/1000/pulse/native or pulse:tcp:<host>
#   alsa:<device>     an ALSA device directly, e.g. alsa:plughw:CARD=BTD700,DEV=0 (see 'aplay -L')
ATV_AUDIO_OUTPUT=pipewire

# Name shown on the Apple TV.
ATV_AUDIO_NAME=atv-audio

# mpv binary.
#ATV_AUDIO_MPV=mpv

# Seconds the output stays open after a pause / stop before it is released (headphones can then switch off).
#ATV_AUDIO_HOLD=300
