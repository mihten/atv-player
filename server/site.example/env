# Copy this folder to server/site/ (git-ignored) and fill in your values; deploy.sh installs it.
# Values are single-quoted: systemd's EnvironmentFile strips double quotes and backslashes otherwise.
# Library roots: {"<key>": "<path>"}. Keys are stored in the library DB: never rename them later.
# Library folders for the FIRST start only: after that they live in <ATV_DATA>/settings.json and are changed in the
# web remote (Settings -> Library). ATV_LIBRARY_BASES (JSON list) limits where the web remote may pick folders;
# default: the parent folders of these.
ATV_ROOTS='{"music": "/media/music", "videos": "/media/videos"}'
# Optional display names in the app / web remote
ATV_ROOT_NAMES='{"music": "Music", "videos": "Music videos"}'
# Optional: Apple TV screenshots (folder must be writable by the service, see override.conf)
#ATV_SHOT_DIR='/srv/screenshots'
# Optional: how users see that folder (shown in the web remote toast)
#ATV_SHOT_SHARE='\\server\share\screenshots'
# Optional: the library folders are a local COPY of another place (e.g. a NAS mirrored by a root job). Rescan in the
# web remote then first writes a token to <spool>/request and waits for the job's JSON status file
# ({"token", "state": waiting|running|done|failed, "changes", "message"}); a systemd .path unit with PathExists= on
# the request file can start the job. Leave unset when the folders are the real library.
#ATV_SYNC_SPOOL='/var/lib/atv-media/sync'
#ATV_SYNC_STATUS='/run/library-sync/status.json'
